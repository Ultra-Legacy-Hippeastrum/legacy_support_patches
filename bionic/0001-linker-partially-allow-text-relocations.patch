From 797e24c33ab09d78b5892ddc6fa7c86130a0577a Mon Sep 17 00:00:00 2001
From: Yaroslav Zviezda <acroreiser@gmail.com>
Date: Sat, 3 May 2025 08:08:04 -0400
Subject: [PATCH] linker: partially allow text relocations

Needed for hammerhead camera blobs.

Change-Id: Ib929f877eaca81bb3ba06c6fba791f78de0fc417
---
 linker/linker.cpp | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/linker/linker.cpp b/linker/linker.cpp
index 5580a83..e2cca03 100644
--- a/linker/linker.cpp
+++ b/linker/linker.cpp
@@ -3385,9 +3385,6 @@ bool soinfo::link_image(const SymbolLookupList& lookup_list, soinfo* local_group
 
 #if !defined(__LP64__)
   if (has_text_relocations) {
-    if (DL_ERROR_AFTER(23, "\"%s\" has text relocations", get_realpath())) {
-      return false;
-    }
     add_dlwarning(get_realpath(), "text relocations");
     // Make segments writable to allow text relocations to work properly. We will later call
     // phdr_table_protect_segments() after all of them are applied.
-- 
2.53.0

