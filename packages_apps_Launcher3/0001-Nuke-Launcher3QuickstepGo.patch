-     */
-    public synchronized @ShareabilityStatus int getStatus(String packageName) {
-        @ShareabilityStatus int status = ShareabilityStatus.UNKNOWN;
-        if (mDataMap.containsKey(packageName)) {
-            status = mDataMap.get(packageName);
-        }
-        return status;
-    }
-
-    /**
